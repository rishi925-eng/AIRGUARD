# Database
DATABASE_URL=postgresql://airguard:airguard_dev_password@postgres:5432/airguard
REDIS_URL=redis://redis:6379

# API Keys (Required for functionality)
OPENAQ_API_KEY=your_openaq_key_here
NASA_FIRMS_API_KEY=your_nasa_firms_key_here
MAPBOX_TOKEN=your_mapbox_token_here
OPENAI_API_KEY=your_openai_api_key_here

# AWS Configuration (For ECS/S3/Cognito deployment)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_COGNITO_USER_POOL_ID=your_cognito_pool_id
AWS_COGNITO_CLIENT_ID=your_cognito_client_id
S3_BUCKET_NAME=airguard-prod-bucket

# Security
JWT_SECRET=super_secret_production_key_change_me
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
WORKERS=4
