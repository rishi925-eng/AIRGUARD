# =============================================================================
# AIRGUARD - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS Cognito
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_CLIENT_SECRET=your_client_secret
COGNITO_DOMAIN=your_cognito_domain

# AWS S3
S3_BUCKET_NAME=airguard-data
S3_IMAGES_BUCKET=airguard-citizen-images
S3_MODELS_BUCKET=airguard-ml-models

# AWS SNS
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:airguard-alerts

# AWS IoT Core
IOT_CORE_ENDPOINT=your_iot_endpoint.iot.us-east-1.amazonaws.com

# AWS SageMaker
SAGEMAKER_ENDPOINT_NAME=airguard-aqi-predictor

# =============================================================================
# Database Configuration
# =============================================================================
# Default zero-setup standalone SQLite:
DATABASE_URL=sqlite:///./airguard_dev.db
# Or PostgreSQL for production/Docker:
# DATABASE_URL=postgresql://airguard:password@localhost:5432/airguard
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airguard
DB_USER=airguard
DB_PASSWORD=your_secure_password_here

# =============================================================================
# External API Keys
# =============================================================================

# OpenAQ - Air Quality Data
# Get your key at: https://openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# Open-Meteo - Weather Data (Free, no key needed)
# But can optionally use commercial API
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# NASA FIRMS - Fire Hotspots
# Get your key at: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=your_nasa_firms_api_key_here

# Mapbox - Maps and Routing
# Get your key at: https://account.mapbox.com/
MAPBOX_TOKEN=your_mapbox_access_token_here
MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here

# =============================================================================
# AI/ML Configuration
# =============================================================================

# AWS Bedrock / Model Configuration
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_REGION=us-east-1

# Strands Agents Configuration
STRANDS_ORCHESTRATOR_ID=airguard-orchestrator
STRANDS_LOG_LEVEL=INFO

# =============================================================================
# Application Configuration
# =============================================================================

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=True
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your_user_pool_id
NEXT_PUBLIC_COGNITO_CLIENT_ID=your_client_id

# =============================================================================
# Security
# =============================================================================
SECRET_KEY=your_secret_key_for_jwt_signing_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Redis (for caching and rate limiting)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Data Ingestion Configuration
# =============================================================================

# How often to fetch data (in minutes)
AIR_QUALITY_FETCH_INTERVAL=15
WEATHER_FETCH_INTERVAL=30
FIRE_FETCH_INTERVAL=60

# Data retention (in days)
DATA_RETENTION_DAYS=90

# =============================================================================
# Alert Configuration
# =============================================================================

# AQI thresholds for alerts
AQI_WARNING_THRESHOLD=100
AQI_DANGER_THRESHOLD=200
AQI_HAZARDOUS_THRESHOLD=300

# =============================================================================
# ML Model Configuration
# =============================================================================

# Model paths (local or S3)
AQI_MODEL_PATH=models/aqi_predictor.pkl
ANOMALY_MODEL_PATH=models/anomaly_detector.pkl

# Prediction horizons (in hours)
FORECAST_HORIZONS=1,3,6,24

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_IOT_INTEGRATION=true
ENABLE_CITIZEN_REPORTS=true
ENABLE_SCHOOL_DASHBOARD=true
ENABLE_CITY_DASHBOARD=true
ENABLE_FAMILY_TRACKING=true
ENABLE_WHAT_IF_SIMULATOR=true

# =============================================================================
# Development / Testing
# =============================================================================
ENVIRONMENT=development
DEBUG=True
TESTING=False

# Mock data for development
USE_MOCK_DATA=false
