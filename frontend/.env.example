# AIRGUARD Frontend Environment Variables

# The base URL of your backend API
# If deploying locally with docker-compose, this can be empty or relative
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Mapbox Access Token for clean-air routing
# If not provided, the app will fall back to free OSRM routing
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# AWS Configuration (for Cognito, IoT, etc if needed on frontend)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
